-- Fonction pour créer un cadre (Frame) avec nom
function createFrame(name, size, img)
	local f = Instance.new("Frame")
	f.Position = UDim2.new(0, 0, 0, 10)
	f.Size = size
	f.BackgroundColor3 = img
	f.BorderSizePixel = 0
	f.Name = name
	f.Parent = mainUI
	
	table.insert(FrameObjects, f)
	
	-- Centre le nom du bouton
	-- (Optionnel, réglage automatice selon le style)
	return f
end

