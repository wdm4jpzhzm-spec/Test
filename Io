--[[
=====================================================================
  NE TE FAIS PAS DUPER - Menu secret de trade (gamepass)
=====================================================================
  Roblox ne permet pas qu'un seul fichier soit à la fois Script et
  LocalScript. Ce fichier contient donc les 2 parties, séparées :

  PARTIE 1 -> à copier dans un SCRIPT (ServerScriptService)
  PARTIE 2 -> à copier dans un LOCALSCRIPT (StarterGui)

  Remplace GAMEPASS_ID par l'ID de ton gamepass dans les 2 parties.
  Les repères "TON SYSTEME" sont à brancher à ton système de trade.
=====================================================================
]]


--====================================================================
-- PARTIE 1 : SCRIPT SERVEUR  (ServerScriptService > Script)
--====================================================================

local MPS = game:GetService("MarketplaceService")
local RS = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local GAMEPASS_ID = 0 -- remplace par ton ID

local remote = Instance.new("RemoteEvent")
remote.Name = "ScamAction"
remote.Parent = RS

-- Vérifie le gamepass côté serveur (jamais faire confiance au client)
local passCache = {}
local function hasPass(plr)
	if passCache[plr] == nil then
		local ok, res = pcall(MPS.UserOwnsGamePassAsync, MPS, plr.UserId, GAMEPASS_ID)
		passCache[plr] = ok and res or false
	end
	return passCache[plr]
end

-- TON SYSTEME : renvoie la session de trade du joueur
-- Exemple de session : {partner = Player, offer = {["Epee"] = true}, frozen = false}
local function getSession(plr)
	return _G.Trades and _G.Trades[plr]
end

-- TON SYSTEME : appelle cette fonction pour envoyer l'affichage du trade
-- à l'autre joueur. Elle ne fait rien si le trade est gelé.
local function updatePartnerUI(session)
	if session.frozen then return end -- l'autre joueur garde l'ancien affichage
	-- TON SYSTEME : envoie session.offer à session.partner ici
end

remote.OnServerEvent:Connect(function(plr, action, itemName)
	if not hasPass(plr) then return end
	local s = getSession(plr)
	if not s then return end

	if action == "Freeze" then
		s.frozen = true
	elseif action == "Remove" and typeof(itemName) == "string" then
		s.offer[itemName] = nil -- retiré pour de vrai côté serveur
		updatePartnerUI(s)       -- ne s'envoie pas si gelé
	end
end)

-- TON SYSTEME : à la fin du trade, pense à révéler l'arnaque à la victime
-- (message du genre "Tu t'es fait avoir ! Voici comment l'éviter...")
-- pour que le jeu reste éducatif.

Players.PlayerRemoving:Connect(function(p)
	passCache[p] = nil
end)


